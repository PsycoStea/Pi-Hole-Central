# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL where the dashboard is accessible. Behind an HTTPS reverse proxy use the
# public https:// address (makes the login cookies Secure), e.g.
# NEXTAUTH_URL=https://piholecentral.example.com
NEXTAUTH_URL=http://localhost:3100

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# SQLite database path (inside container)
DATABASE_URL=file:/app/data/pihole-central.db

# Path to SSH private key on the HOST machine — mounted read-only into the container.
# The Pi user must have passwordless sudo for systemctl and reboot:
#   echo "pi ALL=(ALL) NOPASSWD: /bin/systemctl, /sbin/reboot" | sudo tee /etc/sudoers.d/pihole-recovery
# Leave unset to disable key auth (use per-instance SSH password instead).
SSH_KEY_PATH=~/.ssh/pihole_rsa

# Optional passphrase for the SSH key (leave blank if the key has no passphrase)
SSH_KEY_PASSPHRASE=

# CA certificate (PEM, NOT the CA key) that signed the Pi-hole nodes' https
# certificates, on the HOST — mounted read-only. Needed only for https:// node
# URLs; nodes are then trusted against this CA alone. Leave unset for http nodes.
# PIHOLE_CA_PATH=/path/on/host/pihole-ca.pem
